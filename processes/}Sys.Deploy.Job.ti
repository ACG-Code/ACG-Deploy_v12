#region Prolog
#Region ############################################# HEADER #############################################
# Process: }Sys.Deploy.Job
# Purpose: One parallel deployment job = one item of pDeployment going to one target environment.
#          Started with RunProcess by 'Deployment - Deploy Items' (pParallel = 1).
#            - reads the item's committed definition from the Deployment cube
#            - runs the item's }Sys.API.* worker with ExecuteProcess (globals work inside the job)
#            - writes Run ID, OK, Message, Start, End to }Deployment Jobs (its own cells only)
#            - exit code: 0 = deployed (7 = deployed, a child had minor errors),
#              8 (ProcessBreak) = worker failed; anything else = crashed
#          Cube items in slices: pPart = Structure copies the cube + rules and clears the target
#          cube; pPart = Slice pushes one data slice (}Sys.API.Cube.Data.Push pSlice*).
#          Results go to Job Part 'Item' (whole item / Structure) or 'Slice n'.
#          Never writes to PLOG: gPLogOff = 1 silences PLOG for this job and every worker it calls,
#          because copies of one worker running at once would overwrite each other's log.
#          Rights, blank Name and Active checks are done by the orchestrator before it starts jobs.
# Date Created: 2026.11.24 (ACGI)
# Last Update: 2026.11.24
# Notes:
#     2026.11.24 (ACGI) - Initial Process Creation (parallel deployment Step 2)
#     2026.11.24 (ACGI) - pPart / pSlice* for cube data slices (Step 5)
#EndRegion

#Region --------------- Constants ---------------
cCube = 'Deployment';
cEnvs = 'Deployment Environments';
cEnvDim = 'Deployment-Environments';
cJobs = '}Deployment Jobs';
cAdm = 'System - Admin Parameters';
NumericGlobalVariable('gPLogOff');
NumericGlobalVariable('gDeployOK');
StringGlobalVariable('gDeployMsg');
StringGlobalVariable('gTIStatus');
StringGlobalVariable('gHttpBody');
gPLogOff = 1;
gDeployOK = 0;
gDeployMsg = '';
tStart = NOW;
sPart = UPPER(TRIM(pPart));
#EndRegion

#Region --------------- Validate ---------------
sTEnv = '';
sJobPart = 'Item';
IF(DimensionElementExists('Deployments', pDeployment) = 0);
	gDeployMsg = 'pDeployment "' | pDeployment | '" not found';
ELSEIF(DimensionElementExists('Deployment - Items', pItem) = 0);
	gDeployMsg = 'pItem "' | pItem | '" not found';
ELSEIF(DimensionElementExists(cEnvDim, pTarget) = 0);
	gDeployMsg = 'target environment "' | pTarget | '" not found';
ELSEIF(sPart @<> '' & sPart @<> 'STRUCTURE' & sPart @<> 'SLICE');
	gDeployMsg = 'pPart must be blank, Structure or Slice';
ELSEIF(sPart @= 'SLICE' & DimensionElementExists('Deployment - Job Parts', 'Slice ' | NumberToString(pSliceNo)) = 0);
	gDeployMsg = 'no Job Part for slice ' | NumberToString(pSliceNo);
ELSE;
	sTEnv = DimensionElementPrincipalName(cEnvDim, pTarget);
	IF(sPart @= 'SLICE');
		sJobPart = 'Slice ' | NumberToString(pSliceNo);
	ENDIF;
ENDIF;
#EndRegion

#Region --------------- Deploy the item to the target ---------------
IF(gDeployMsg @= '');
	sType = CellGetS(cCube, pDeployment, pItem, 'Type');
	sName = CellGetS(cCube, pDeployment, pItem, 'Name');
	sThisDB = CellGetS(cAdm, 'Database Name', 'String');
	sThisTenant = CellGetS('}API Control', 'Tenant ID', 'String');
	sTDB = CellGetS(cEnvs, sTEnv, 'Database Name');
	sTTenant = CellGetS(cEnvs, sTEnv, 'Tenant ID');
	nSameTenant = IF(sTTenant @= '' % UPPER(sTTenant) @= UPPER(sThisTenant), 1, 0);

	# workers get the environment; }Sys.API.Request resolves its database, URL, tenant and key
	IF(sTDB @= '');
		gDeployMsg = 'no Database Name for environment ' | sTEnv;
	ELSEIF(nSameTenant = 1 & UPPER(sTDB) @= UPPER(sThisDB) & sType @<> 'RunTI');
		gDeployMsg = 'target is the source database';
	ELSEIF(sPart @<> '' & sType @<> 'Cube');
		gDeployMsg = 'pPart is only for Cube items';
	ELSEIF(sType @= 'Dimension');
		ExecuteProcess('}Sys.API.Dim.Copy.ToDatabase', 'pDim', sName, 'pTargetDB', sTEnv,
			'pAttrValues', IF(UPPER(CellGetS(cCube, pDeployment, pItem, 'Include Attribute Values')) @= 'YES', 1, 0),
			'pAttrRules', IF(UPPER(CellGetS(cCube, pDeployment, pItem, 'Copy Attribute Rules')) @= 'YES', 1, 0),
			'pSubsets', IF(UPPER(CellGetS(cCube, pDeployment, pItem, 'Include Subsets')) @= 'YES', 1, 0),
			'pSecurity', IF(UPPER(CellGetS(cCube, pDeployment, pItem, 'Include Security Cube')) @= 'YES', 1, 0));
	ELSEIF(sType @= 'Subset');
		nPipe = SCAN('|', sName);
		IF(nPipe <= 1);
			gDeployMsg = 'Subset Name must be Dimension|Subset';
		ELSE;
			sSubDim = SUBST(sName, 1, nPipe - 1);
			sSubs = SUBST(sName, nPipe + 1, LONG(sName) - nPipe);
			sSubHier = '';
			nColon = SCAN(':', sSubDim);
			IF(nColon > 1);
				sSubHier = SUBST(sSubDim, nColon + 1, LONG(sSubDim) - nColon);
				sSubDim = SUBST(sSubDim, 1, nColon - 1);
			ENDIF;
			ExecuteProcess('}Sys.API.Subset.Copy', 'pDim', sSubDim, 'pHier', sSubHier, 'pSubsets', sSubs, 'pTargetDB', sTEnv);
		ENDIF;
	ELSEIF(sType @= 'Cube' & sPart @= 'STRUCTURE');
		# cube + rules, then clear the target so the slices load into an empty cube
		ExecuteProcess('}Sys.API.Cube.Copy', 'pCube', sName, 'pTargetDB', sTEnv, 'pRules', 1, 'pData', 0, 'pClear', 0);
		IF(gDeployOK = 1);
			sDone = gDeployMsg;
			gDeployOK = 0;
			sCubeTI = '';
			nC = 1;
			WHILE(nC <= LONG(sName));
				sC = SUBST(sName, nC, 1);
				sCubeTI = sCubeTI | IF(sC @= '''', '''''', sC);
				nC = nC + 1;
			END;
			ExecuteProcess('}Sys.API.Exec.TI', 'pDB', sTEnv, 'pCode', 'CubeClearData(''' | sCubeTI | ''');');
			IF(gTIStatus @= 'CompletedSuccessfully');
				gDeployOK = 1;
				gDeployMsg = sDone | ', target cleared';
			ELSE;
				gDeployMsg = sDone | ', clear of target cube failed: ' | SUBST(gHttpBody, 1, 500);
			ENDIF;
		ENDIF;
	ELSEIF(sType @= 'Cube' & sPart @= 'SLICE');
		ExecuteProcess('}Sys.API.Cube.Data.Push', 'pCube', sName, 'pTargetDB', sTEnv, 'pAllElements', 0, 'pClear', 0,
			'pSliceDim', pSliceDim, 'pSliceNo', pSliceNo, 'pSliceCount', pSliceCount);
		gDeployMsg = 'slice ' | NumberToString(pSliceNo) | '/' | NumberToString(pSliceCount) | ' of ' | pSliceDim | ': ' | gDeployMsg;
	ELSEIF(sType @= 'Cube');
		ExecuteProcess('}Sys.API.Cube.Copy', 'pCube', sName, 'pTargetDB', sTEnv, 'pRules', 1, 'pData', 1, 'pClear', 1);
	ELSEIF(sType @= 'View');
		nPipe = SCAN('|', sName);
		IF(nPipe <= 1);
			gDeployMsg = 'View Name must be Cube|View';
		ELSE;
			ExecuteProcess('}Sys.API.View.Copy', 'pCube', SUBST(sName, 1, nPipe - 1), 'pView', SUBST(sName, nPipe + 1, LONG(sName) - nPipe), 'pTargetDB', sTEnv);
		ENDIF;
	ELSEIF(sType @= 'RunTI' % sType @= 'TI');
		sTO = CellGetS(cCube, pDeployment, pItem, 'Timeout');
		ExecuteProcess('}Sys.API.Process.Run', 'pTargetDB', sTEnv, 'pProcess', sName,
			'pParam1', CellGetS(cCube, pDeployment, pItem, 'Parameter 1'),
			'pParam2', CellGetS(cCube, pDeployment, pItem, 'Parameter 2'),
			'pParam3', CellGetS(cCube, pDeployment, pItem, 'Parameter 3'),
			'pParam4', CellGetS(cCube, pDeployment, pItem, 'Parameter 4'),
			'pParam5', CellGetS(cCube, pDeployment, pItem, 'Parameter 5'),
			'pParam6', CellGetS(cCube, pDeployment, pItem, 'Parameter 6'),
			'pParam7', CellGetS(cCube, pDeployment, pItem, 'Parameter 7'),
			'pParam8', CellGetS(cCube, pDeployment, pItem, 'Parameter 8'),
			'pParam9', CellGetS(cCube, pDeployment, pItem, 'Parameter 9'),
			'pParam10', CellGetS(cCube, pDeployment, pItem, 'Parameter 10'),
			'pTimeout', IF(sTO @= '', pTimeout, StringToNumber(sTO)), 'pPoll', 5);
	ELSEIF(sType @= 'Process' % sType @= 'Chore' % sType @= 'Rule');
		ExecuteProcess('}Sys.API.Object.Copy', 'pType', sType, 'pName', sName, 'pTargetDB', sTEnv);
	ELSE;
		gDeployMsg = 'unknown Type "' | sType | '"';
	ENDIF;
ENDIF;
#EndRegion

#Region --------------- Result ---------------
IF(sTEnv @<> '');
	CellPutS(pRunID, cJobs, pDeployment, pItem, sTEnv, sJobPart, 'Run ID');
	CellPutN(gDeployOK, cJobs, pDeployment, pItem, sTEnv, sJobPart, 'OK');
	CellPutS(SUBST(IF(gDeployOK = 0 & gDeployMsg @= '', 'failed - no message from worker', gDeployMsg), 1, 2000), cJobs, pDeployment, pItem, sTEnv, sJobPart, 'Message');
	CellPutN(tStart, cJobs, pDeployment, pItem, sTEnv, sJobPart, 'Start');
	CellPutN(NOW, cJobs, pDeployment, pItem, sTEnv, sJobPart, 'End');
ENDIF;

# exit code 8 tells the orchestrator the item failed on this target (it wins over minor errors)
IF(gDeployOK = 0);
	ProcessBreak;
ENDIF;
#EndRegion

#endregion