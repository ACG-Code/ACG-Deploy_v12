#region Prolog
#Region ############################################# HEADER #############################################
# Process: Deployment - Deploy Items
# Purpose: Deploy the active items of a deployment from this database to its targets
#          with the }Sys.API.* control processes (ExecuteHttpRequest) - PA SaaS / TM1 v12.
#          Replaces the YAML file + ACG-Deploy.exe step of the on-prem version.
#            Source : must be this database (the workers read locally and push to targets)
#            Targets: Target 1-5 per item = elements of Deployment-Environments; each has a
#                     Database Name and, for another PA SaaS tenant, Base URL, Tenant ID and
#                     Secret (}API_Control element with its API key). Blank = this tenant.
#            Items  : Dimension, Subset (Dim|Sub1;Sub2 or Dim:Hier|Sub), Cube, View (Cube|View),
#                     RunTI, Process, Chore, Rule
#            Rights : Deploy_Admin = everything; Deploy_User = Dimension, Subset, View, RunTI and
#                     Cubes with 'Security' in the name
#            Status : Deployment Start / End / Duration / Status per item and on All Items
#          pParallel = 1: one job (}Sys.Deploy.Job, RunProcess) per item per target, in waves:
#            1 Dimension, 2 Subset, 3 Cube, 4 Rule, 5 View, 6 cube data slices, 7 Process,
#            8 Chore, 9 RunTI (an item's Wave measure overrides). Up to max_workers jobs run at
#            once; wave 9 runs one job at a time in item order. A failed job on a target skips that
#            target's later waves. Cube items: structure + rules + clear in their wave, then the
#            data in slices in wave 6 (or the wave after): split dimension = Parameter
#            'pSplitDim|<dim>' or the cube's largest dimension, slices = 'pSlices|<n>' or
#            max_workers (1 = no slices). A job succeeds when its worker reports OK, as in the
#            one-at-a-time path. Jobs write }Deployment Jobs; this process reads it only after
#            the last wave (its view of a cube is fixed at the first read) and is the only one
#            writing PLOG.
# Date Created: 2026.11.24 (ACGI)
# Last Update: 2026.11.24
# Notes:
#     2026.11.24 (ACGI) - Initial Process Creation (PA SaaS rewrite of the ACG-Deploy TI)
#     2026.11.24 (ACGI) - Workers called with the target environment (cross-tenant support)
#     2026.11.24 (ACGI) - Process Example standard: regions, PLOG logging, nError + ProcessBreak
#     2026.11.24 (ACGI) - Process Log status (T08): ERROR only for critical errors
#     2026.11.24 (ACGI) - pParallel: parallel waves with RunProcess jobs (}Sys.Deploy.Job)
#     2026.11.24 (ACGI) - Parallel: success = worker OK (exit 0 or 7); cube data in slices
#EndRegion

#Region --------------- Constants ---------------
cLogProc = 'PLOG';
cProc = GetProcessName;
cUser = NumberToString(DIMIX('}Clients', TM1USER));
cTimestamp = TIMST(now, '\Y\m\d\h\i\s');
cRandomInt = NumberToString(INT(RAND() * 1005));
cView = '%cProc%.%cUser%.%cTimestamp%.%cRandomInt%';
cTemp = 1;
cCube = 'Deployment';
cEnvs = 'Deployment Environments';
cEnvDim = 'Deployment-Environments';
cItems = 'Deployment - Items';
cAdm = 'System - Admin Parameters';
cAdminGrp = 'Deploy_Admin';
cUserGrp = 'Deploy_User';
cFmt = '\Y-\m-\d \h:\i:\s';
cJobs = '}Deployment Jobs';
cJobProc = '}Sys.Deploy.Job';
cJobParts = 'Deployment - Job Parts';
cRunning = 10;
cMaxSlices = 32;
cSep = Char(1);
cFld = Char(2);
cTSep = Char(3);
#EndRegion

#Region --------------- Initialize Logging ---------------
ExecuteProcess(cLogProc, 'pFlag', 'INIT', 'pProc', cProc);
ExecuteProcess(cLogProc, 'pFlag', 'MSG', 'pProc', cProc, 'pMSG', 'pDeployment=' | pDeployment, 'pLine', 'P01');
ExecuteProcess(cLogProc, 'pFlag', 'MSG', 'pProc', cProc, 'pMSG', 'pParallel=' | NumberToString(pParallel), 'pLine', 'P02');
#EndRegion

#Region --------------- Error Handling ---------------
nError = 0;
nCritical = 0;
sMessage = '';
nAdmin = 0;

IF(pDeployment @= '' % DimensionElementExists('Deployments', pDeployment) = 0);
	nError = 1;
	sMessage = 'pDeployment: "' | pDeployment | '" is invalid';
ENDIF;

IF(nError = 0);
	sUser = TM1User();
	sIsAdmin = CellGetS('}ClientGroups', sUser, cAdminGrp);
	sIsUser = CellGetS('}ClientGroups', sUser, cUserGrp);
	IF(UPPER(sIsAdmin) @<> UPPER(cAdminGrp) & UPPER(sIsUser) @<> UPPER(cUserGrp));
		nError = 1;
		sMessage = 'User has no rights to perform deployments';
	ENDIF;
	nAdmin = IF(UPPER(sIsAdmin) @= UPPER(cAdminGrp), 1, 0);
ENDIF;

IF(nError = 0 & UPPER(CellGetS(cCube, pDeployment, 'All Items', 'Active')) @<> 'YES');
	nError = 1;
	sMessage = 'Deployment is not Active';
ENDIF;

IF(nError = 0 & pParallel = 1);
	IF(CubeExists(cJobs) = 0 % DIMIX('}Processes', cJobProc) = 0 % DimensionExists(cJobParts) = 0);
		nError = 1;
		sMessage = 'pParallel = 1 needs ' | cJobs | ' and ' | cJobProc | ' - run }Sys.Deploy.Setup';
	ELSEIF(CubeDimensionCountGet(cJobs) <> 5);
		nError = 1;
		sMessage = cJobs | ' is an old version - run }Sys.Deploy.Setup';
	ENDIF;
ENDIF;

sThisDB = CellGetS(cAdm, 'Database Name', 'String');
sThisTenant = CellGetS('}API Control', 'Tenant ID', 'String');
IF(nError = 0);
	sSrcEnv = CellGetS(cCube, pDeployment, 'All Items', 'Source');
	IF(sSrcEnv @<> '');
		IF(DimensionElementExists(cEnvDim, sSrcEnv) = 0);
			nError = 1;
			sMessage = 'Source environment "' | sSrcEnv | '" not found';
		ELSE;
			sSrcDB = CellGetS(cEnvs, DimensionElementPrincipalName(cEnvDim, sSrcEnv), 'Database Name');
			IF(UPPER(sSrcDB) @<> UPPER(sThisDB));
				nError = 1;
				sMessage = 'Source ' | sSrcEnv | ' is ' | sSrcDB | ' - run this process in that database';
			ENDIF;
		ENDIF;
	ENDIF;
ENDIF;

IF(nError = 1);
	IF(pDeployment @<> '' & DimensionElementExists('Deployments', pDeployment) = 1);
		CellPutS(sMessage, cCube, pDeployment, 'All Items', 'Deployment Status');
	ENDIF;
	ExecuteProcess(cLogProc, 'pFlag', 'MSG', 'pProc', cProc, 'pMSG', sMessage);
	ExecuteProcess(cLogProc, 'pFlag', 'MSG', 'pProc', cProc, 'pMSG', 'Critical errors, exiting');
	nCritical = 1;
	ProcessBreak;
ENDIF;
#EndRegion

#Region --------------- Variables ---------------
NumericGlobalVariable('gDeployOK');
StringGlobalVariable('gDeployMsg');
sView = EXPAND(cView);
tRunStart = NOW;
sDefTimeout = CellGetS(cAdm, 'process_timeout', 'String');
nDefTimeout = IF(sDefTimeout @= '', 14400, StringToNumber(sDefTimeout));
nItems = 0;
nFailed = 0;
#EndRegion

IF(pParallel = 1);
#Region --------------- Parallel: plan ---------------
# sPlan record per runnable item:
#   item FLD wave FLD targets (TSep-separated) FLD failures found here FLD split dim FLD slices FLD data wave
sRunID = cTimestamp | '.' | cRandomInt;
sMW = CellGetS(cAdm, 'max_workers', 'String');
nMaxWorkers = IF(sMW @= '', 4, StringToNumber(sMW));
IF(nMaxWorkers < 1);
	nMaxWorkers = 1;
ENDIF;
ExecuteProcess(cLogProc, 'pFlag', 'MSG', 'pProc', cProc, 'pMSG', 'Deploying ' | pDeployment | ' from ' | sThisDB
	| ' in parallel waves, max_workers=' | NumberToString(nMaxWorkers) | ', run ' | sRunID);
sPlan = '';
nLoop = 1;
nMax = DIMSIZ(cItems);
WHILE(nLoop <= nMax);
	sItem = DIMNM(cItems, nLoop);
	IF(DTYPE(cItems, sItem) @<> 'C' & UPPER(CellGetS(cCube, pDeployment, sItem, 'Active')) @= 'YES');
		nItems = nItems + 1;
		sType = CellGetS(cCube, pDeployment, sItem, 'Type');
		sName = CellGetS(cCube, pDeployment, sItem, 'Name');
		CellPutS('', cCube, pDeployment, sItem, 'Deployment End');
		CellPutS('', cCube, pDeployment, sItem, 'Deployment Duration');

		sItemFail = '';
		IF(nAdmin = 0);
			IF(sType @= 'Process' % sType @= 'Chore' % sType @= 'Rule');
				sItemFail = 'Insufficient rights to deploy ' | sType | 's';
			ELSEIF(sType @= 'Cube' & SCAN('SECURITY', UPPER(sName)) = 0);
				sItemFail = 'Insufficient rights to deploy Cubes';
			ENDIF;
		ENDIF;
		IF(sItemFail @= '' & sName @= '');
			sItemFail = 'Name is blank';
		ENDIF;

		# targets that exist go to jobs; unknown ones fail here
		sTargets = '';
		sPreFail = '';
		nTargets = 0;
		nT = 1;
		WHILE(nT <= 5);
			sTEnv = CellGetS(cCube, pDeployment, sItem, 'Target ' | NumberToString(nT));
			IF(sTEnv @<> '' & UPPER(sTEnv) @<> 'NONE');
				nTargets = nTargets + 1;
				IF(DimensionElementExists(cEnvDim, sTEnv) = 1);
					sTargets = sTargets | DimensionElementPrincipalName(cEnvDim, sTEnv) | cTSep;
				ELSE;
					sPreFail = sPreFail | IF(sPreFail @= '', '', '; ') | sTEnv | ': no Database Name for environment ' | sTEnv;
				ENDIF;
			ENDIF;
			nT = nT + 1;
		END;
		IF(sItemFail @= '' & nTargets = 0);
			sItemFail = 'No targets specified';
		ENDIF;

		# wave: the item's Wave measure, else by type
		IF(sType @= 'Dimension');
			nWave = 1;
		ELSEIF(sType @= 'Subset');
			nWave = 2;
		ELSEIF(sType @= 'Cube');
			nWave = 3;
		ELSEIF(sType @= 'Rule');
			nWave = 4;
		ELSEIF(sType @= 'View');
			nWave = 5;
		ELSEIF(sType @= 'Process');
			nWave = 7;
		ELSEIF(sType @= 'Chore');
			nWave = 8;
		ELSE;
			nWave = 9;
		ENDIF;
		sW = TRIM(CellGetS(cCube, pDeployment, sItem, 'Wave'));
		IF(sW @<> '');
			nW = INT(StringToNumber(sW));
			IF(nW >= 1 & nW <= 9);
				nWave = nW;
			ENDIF;
		ENDIF;

		# cube data in slices: split dimension and slice count from 'pSplitDim|x' / 'pSlices|n'
		sSplitDim = '';
		nSlices = 0;
		nDataWave = 0;
		IF(sType @= 'Cube' & sItemFail @= '' & CubeExists(sName) = 1 & nWave < 9);
			nSlices = nMaxWorkers;
			nP = 1;
			WHILE(nP <= 10);
				sPar = CellGetS(cCube, pDeployment, sItem, 'Parameter ' | NumberToString(nP));
				nPipe = SCAN('|', sPar);
				IF(nPipe > 1);
					sParN = UPPER(TRIM(SUBST(sPar, 1, nPipe - 1)));
					sParV = TRIM(SUBST(sPar, nPipe + 1, LONG(sPar) - nPipe));
					IF(sParN @= 'PSPLITDIM');
						sSplitDim = sParV;
					ELSEIF(sParN @= 'PSLICES');
						nSlices = INT(StringToNumber(sParV));
					ENDIF;
				ENDIF;
				nP = nP + 1;
			END;
			IF(nSlices > cMaxSlices);
				nSlices = cMaxSlices;
			ENDIF;
			# split dimension must be one of the cube's; default = its largest dimension
			nFound = 0;
			nBig = 0;
			sBig = '';
			nD = 1;
			WHILE(nD <= CubeDimensionCountGet(sName));
				sD = TABDIM(sName, nD);
				IF(UPPER(sD) @= UPPER(sSplitDim));
					nFound = 1;
					sSplitDim = sD;
				ENDIF;
				IF(DIMSIZ(sD) > nBig);
					nBig = DIMSIZ(sD);
					sBig = sD;
				ENDIF;
				nD = nD + 1;
			END;
			IF(nFound = 0);
				sSplitDim = sBig;
			ENDIF;
			IF(nSlices >= 2);
				nDataWave = IF(nWave < 6, 6, nWave + 1);
			ELSE;
				nSlices = 0;
				sSplitDim = '';
			ENDIF;
		ENDIF;

		IF(sItemFail @<> '');
			nFailed = nFailed + 1;
			tNow = NOW;
			CellPutS(TIMST(tNow, cFmt), cCube, pDeployment, sItem, 'Deployment Start');
			CellPutS(TIMST(tNow, cFmt), cCube, pDeployment, sItem, 'Deployment End');
			CellPutS('0', cCube, pDeployment, sItem, 'Deployment Duration');
			CellPutS(SUBST(sItemFail, 1, 1000), cCube, pDeployment, sItem, 'Deployment Status');
			ExecuteProcess(cLogProc, 'pFlag', 'MSG', 'pProc', cProc, 'pMSG', sItem | ': ' | sType | ' ' | sName | ' FAILED: ' | sItemFail);
		ELSE;
			sPlan = sPlan | sItem | cFld | NumberToString(nWave) | cFld | sTargets | cFld | sPreFail
				| cFld | sSplitDim | cFld | NumberToString(nSlices) | cFld | NumberToString(nDataWave) | cSep;
			ExecuteProcess(cLogProc, 'pFlag', 'MSG', 'pProc', cProc, 'pMSG', sItem | ': ' | sType | ' ' | sName | ' -> wave ' | NumberToString(nWave)
				| IF(nSlices > 0, ', data in ' | NumberToString(nSlices) | ' slices of ' | sSplitDim | ' -> wave ' | NumberToString(nDataWave), ''));
		ENDIF;
	ENDIF;
	nLoop = nLoop + 1;
END;
#EndRegion

#Region --------------- Parallel: run the waves ---------------
# sQueue record: item FLD target FLD part FLD split dim FLD slice no FLD slices   (part: Item | Structure | Slice n)
# sRun record  : job FLD item FLD target FLD part
# sDone record : item FLD target FLD part FLD job FLD exit code  (-1 skipped, -2 timeout)
sDone = '';
sFailTargets = cTSep;
nTimedOut = 0;
tDeadline = tRunStart + nDefTimeout / 86400;
nWaveNo = 1;
WHILE(nWaveNo <= 9);
	# queue = this wave's jobs, item order then target order (then slice order)
	sQueue = '';
	nQueued = 0;
	sRest = sPlan;
	nP = SCAN(cSep, sRest);
	WHILE(nP > 0);
		sRec = SUBST(sRest, 1, nP - 1);
		sRest = SUBST(sRest, nP + 1, LONG(sRest) - nP);
		n1 = SCAN(cFld, sRec);
		sItem = SUBST(sRec, 1, n1 - 1);
		sRec = SUBST(sRec, n1 + 1, LONG(sRec) - n1);
		n1 = SCAN(cFld, sRec);
		nWave = StringToNumber(SUBST(sRec, 1, n1 - 1));
		sRec = SUBST(sRec, n1 + 1, LONG(sRec) - n1);
		n1 = SCAN(cFld, sRec);
		sTargets = SUBST(sRec, 1, n1 - 1);
		sRec = SUBST(sRec, n1 + 1, LONG(sRec) - n1);
		n1 = SCAN(cFld, sRec);
		sRec = SUBST(sRec, n1 + 1, LONG(sRec) - n1);
		n1 = SCAN(cFld, sRec);
		sSplitDim = SUBST(sRec, 1, n1 - 1);
		sRec = SUBST(sRec, n1 + 1, LONG(sRec) - n1);
		n1 = SCAN(cFld, sRec);
		nSlices = StringToNumber(SUBST(sRec, 1, n1 - 1));
		nDataWave = StringToNumber(SUBST(sRec, n1 + 1, LONG(sRec) - n1));
		IF(nWave = nWaveNo % (nSlices > 0 & nDataWave = nWaveNo));
			nT = SCAN(cTSep, sTargets);
			WHILE(nT > 0);
				sTEnv = SUBST(sTargets, 1, nT - 1);
				sTargets = SUBST(sTargets, nT + 1, LONG(sTargets) - nT);
				nSkip = IF(nTimedOut = 1 % SCAN(cTSep | sTEnv | cTSep, sFailTargets) > 0, 1, 0);
				IF(nWave = nWaveNo);
					sPart = IF(nSlices > 0, 'Structure', 'Item');
					IF(nSkip = 1);
						sDone = sDone | sItem | cFld | sTEnv | cFld | sPart | cFld | '' | cFld | '-1' | cSep;
					ELSE;
						sQueue = sQueue | sItem | cFld | sTEnv | cFld | sPart | cFld | '' | cFld | '0' | cFld | '0' | cSep;
						nQueued = nQueued + 1;
					ENDIF;
				ELSE;
					nS = 1;
					WHILE(nS <= nSlices);
						sPart = 'Slice ' | NumberToString(nS);
						IF(nSkip = 1);
							sDone = sDone | sItem | cFld | sTEnv | cFld | sPart | cFld | '' | cFld | '-1' | cSep;
						ELSE;
							sQueue = sQueue | sItem | cFld | sTEnv | cFld | sPart | cFld | sSplitDim | cFld | NumberToString(nS) | cFld | NumberToString(nSlices) | cSep;
							nQueued = nQueued + 1;
						ENDIF;
						nS = nS + 1;
					END;
				ENDIF;
				nT = SCAN(cTSep, sTargets);
			END;
		ENDIF;
		nP = SCAN(cSep, sRest);
	END;

	IF(nQueued > 0);
		nCap = IF(nWaveNo = 9, 1, nMaxWorkers);
		ExecuteProcess(cLogProc, 'pFlag', 'MSG', 'pProc', cProc, 'pMSG', 'Wave ' | NumberToString(nWaveNo) | ': '
			| NumberToString(nQueued) | ' jobs, ' | NumberToString(nCap) | ' at a time');
		sRun = '';
		nRun = 0;
		WHILE(sQueue @<> '' % nRun > 0);
			# fill free slots
			WHILE(nRun < nCap & sQueue @<> '');
				nP = SCAN(cSep, sQueue);
				sRec = SUBST(sQueue, 1, nP - 1);
				sQueue = SUBST(sQueue, nP + 1, LONG(sQueue) - nP);
				n1 = SCAN(cFld, sRec);
				sItem = SUBST(sRec, 1, n1 - 1);
				sRec = SUBST(sRec, n1 + 1, LONG(sRec) - n1);
				n1 = SCAN(cFld, sRec);
				sTEnv = SUBST(sRec, 1, n1 - 1);
				sRec = SUBST(sRec, n1 + 1, LONG(sRec) - n1);
				n1 = SCAN(cFld, sRec);
				sPart = SUBST(sRec, 1, n1 - 1);
				sRec = SUBST(sRec, n1 + 1, LONG(sRec) - n1);
				n1 = SCAN(cFld, sRec);
				sSplitDim = SUBST(sRec, 1, n1 - 1);
				sRec = SUBST(sRec, n1 + 1, LONG(sRec) - n1);
				n1 = SCAN(cFld, sRec);
				nSliceNo = StringToNumber(SUBST(sRec, 1, n1 - 1));
				nSlices = StringToNumber(SUBST(sRec, n1 + 1, LONG(sRec) - n1));
				sJobPart = IF(sPart @= 'Item', '', IF(sPart @= 'Structure', 'Structure', 'Slice'));
				sJob = RunProcess(cJobProc, 'pDeployment', pDeployment, 'pItem', sItem, 'pTarget', sTEnv,
					'pRunID', sRunID, 'pTimeout', nDefTimeout, 'pPart', sJobPart,
					'pSliceDim', sSplitDim, 'pSliceNo', nSliceNo, 'pSliceCount', nSlices);
				sRun = sRun | sJob | cFld | sItem | cFld | sTEnv | cFld | sPart | cSep;
				nRun = nRun + 1;
				ExecuteProcess(cLogProc, 'pFlag', 'MSG', 'pProc', cProc, 'pMSG', '     started ' | sItem | ' -> ' | sTEnv
					| IF(sPart @= 'Item', '', ' ' | sPart) | ' job ' | sJob);
			END;

			Sleep(500);

			# check running jobs; any status other than 10 is finished
			sKeep = '';
			nRun = 0;
			sRest = sRun;
			nP = SCAN(cSep, sRest);
			WHILE(nP > 0);
				sRec = SUBST(sRest, 1, nP - 1);
				sRest = SUBST(sRest, nP + 1, LONG(sRest) - nP);
				n1 = SCAN(cFld, sRec);
				sJob = SUBST(sRec, 1, n1 - 1);
				sRec2 = SUBST(sRec, n1 + 1, LONG(sRec) - n1);
				n1 = SCAN(cFld, sRec2);
				sItem = SUBST(sRec2, 1, n1 - 1);
				sRec2 = SUBST(sRec2, n1 + 1, LONG(sRec2) - n1);
				n1 = SCAN(cFld, sRec2);
				sTEnv = SUBST(sRec2, 1, n1 - 1);
				sPart = SUBST(sRec2, n1 + 1, LONG(sRec2) - n1);
				nStat = GetJobStatus(sJob);
				IF(nStat = cRunning);
					sKeep = sKeep | sRec | cSep;
					nRun = nRun + 1;
				ELSE;
					sDone = sDone | sItem | cFld | sTEnv | cFld | sPart | cFld | sJob | cFld | NumberToString(nStat) | cSep;
					ExecuteProcess(cLogProc, 'pFlag', 'MSG', 'pProc', cProc, 'pMSG', '     finished ' | sItem | ' -> ' | sTEnv
						| IF(sPart @= 'Item', '', ' ' | sPart) | ' exit ' | NumberToString(nStat));
					# 0 = OK, 7 = OK with minor errors in a child; the job ends 8 when its worker failed
					IF(nStat <> 0 & nStat <> 7 & SCAN(cTSep | sTEnv | cTSep, sFailTargets) = 0);
						sFailTargets = sFailTargets | sTEnv | cTSep;
					ENDIF;
				ENDIF;
				nP = SCAN(cSep, sRest);
			END;
			sRun = sKeep;

			# overall time limit: jobs cannot be stopped, they are left to finish
			IF(NOW > tDeadline & (nRun > 0 % sQueue @<> ''));
				nTimedOut = 1;
				sRest = sRun;
				nP = SCAN(cSep, sRest);
				WHILE(nP > 0);
					sRec = SUBST(sRest, 1, nP - 1);
					sRest = SUBST(sRest, nP + 1, LONG(sRest) - nP);
					n1 = SCAN(cFld, sRec);
					sJob = SUBST(sRec, 1, n1 - 1);
					sDone = sDone | SUBST(sRec, n1 + 1, LONG(sRec) - n1) | cFld | sJob | cFld | '-2' | cSep;
					nP = SCAN(cSep, sRest);
				END;
				sRest = sQueue;
				nP = SCAN(cSep, sRest);
				WHILE(nP > 0);
					sRec = SUBST(sRest, 1, nP - 1);
					sRest = SUBST(sRest, nP + 1, LONG(sRest) - nP);
					n1 = SCAN(cFld, sRec);
					sItem = SUBST(sRec, 1, n1 - 1);
					sRec = SUBST(sRec, n1 + 1, LONG(sRec) - n1);
					n1 = SCAN(cFld, sRec);
					sTEnv = SUBST(sRec, 1, n1 - 1);
					sRec = SUBST(sRec, n1 + 1, LONG(sRec) - n1);
					n1 = SCAN(cFld, sRec);
					sPart = SUBST(sRec, 1, n1 - 1);
					sDone = sDone | sItem | cFld | sTEnv | cFld | sPart | cFld | '' | cFld | '-2' | cSep;
					nP = SCAN(cSep, sRest);
				END;
				sRun = '';
				nRun = 0;
				sQueue = '';
				ExecuteProcess(cLogProc, 'pFlag', 'MSG', 'pProc', cProc, 'pMSG', 'process_timeout reached (' | NumberToString(nDefTimeout) | 's) - remaining jobs marked Timeout');
			ENDIF;
		END;
	ENDIF;
	nWaveNo = nWaveNo + 1;
END;
#EndRegion

#Region --------------- Parallel: results (first read of }Deployment Jobs) ---------------
sRest = sPlan;
nP = SCAN(cSep, sRest);
WHILE(nP > 0);
	sRec = SUBST(sRest, 1, nP - 1);
	sRest = SUBST(sRest, nP + 1, LONG(sRest) - nP);
	n1 = SCAN(cFld, sRec);
	sItem = SUBST(sRec, 1, n1 - 1);
	sTmp = SUBST(sRec, n1 + 1, LONG(sRec) - n1);
	n1 = SCAN(cFld, sTmp);
	sTmp = SUBST(sTmp, n1 + 1, LONG(sTmp) - n1);
	n1 = SCAN(cFld, sTmp);
	sTmp = SUBST(sTmp, n1 + 1, LONG(sTmp) - n1);
	n1 = SCAN(cFld, sTmp);
	sItemFail = SUBST(sTmp, 1, n1 - 1);
	tMin = 0;
	tMax = 0;

	sJRest = sDone;
	nJ = SCAN(cSep, sJRest);
	WHILE(nJ > 0);
		sJRec = SUBST(sJRest, 1, nJ - 1);
		sJRest = SUBST(sJRest, nJ + 1, LONG(sJRest) - nJ);
		n1 = SCAN(cFld, sJRec);
		IF(SUBST(sJRec, 1, n1 - 1) @= sItem);
			sJRec = SUBST(sJRec, n1 + 1, LONG(sJRec) - n1);
			n1 = SCAN(cFld, sJRec);
			sTEnv = SUBST(sJRec, 1, n1 - 1);
			sJRec = SUBST(sJRec, n1 + 1, LONG(sJRec) - n1);
			n1 = SCAN(cFld, sJRec);
			sPart = SUBST(sJRec, 1, n1 - 1);
			sJRec = SUBST(sJRec, n1 + 1, LONG(sJRec) - n1);
			n1 = SCAN(cFld, sJRec);
			sJob = SUBST(sJRec, 1, n1 - 1);
			nCode = StringToNumber(SUBST(sJRec, n1 + 1, LONG(sJRec) - n1));
			sCell = IF(sPart @= 'Structure', 'Item', sPart);
			sLabel = sTEnv | IF(sPart @= 'Item', '', ' ' | sPart);
			nOK = 0;
			IF(nCode = -1);
				sMsg = 'Skipped - earlier failure on ' | sTEnv;
			ELSEIF(nCode = -2);
				sMsg = IF(sJob @= '', 'Timeout - not started', 'Timeout - still running after ' | NumberToString(nDefTimeout) | 's, not stopped (job ' | sJob | ')');
			ELSEIF(CellGetS(cJobs, pDeployment, sItem, sTEnv, sCell, 'Run ID') @= sRunID);
				# as in the one-at-a-time path, the worker's OK decides
				nOK = IF(CellGetN(cJobs, pDeployment, sItem, sTEnv, sCell, 'OK') = 1, 1, 0);
				sMsg = CellGetS(cJobs, pDeployment, sItem, sTEnv, sCell, 'Message');
				IF(nOK = 1 & nCode = 7);
					sMsg = sMsg | ' (minor errors in the job log)';
				ENDIF;
				tS = CellGetN(cJobs, pDeployment, sItem, sTEnv, sCell, 'Start');
				tE = CellGetN(cJobs, pDeployment, sItem, sTEnv, sCell, 'End');
				IF(tS > 0 & (tMin = 0 % tS < tMin));
					tMin = tS;
				ENDIF;
				IF(tE > tMax);
					tMax = tE;
				ENDIF;
			ELSE;
				sMsg = 'job ended with exit code ' | NumberToString(nCode) | ' and no result - see its TI log (job ' | sJob | ')';
			ENDIF;
			ExecuteProcess(cLogProc, 'pFlag', 'MSG', 'pProc', cProc, 'pMSG',
				'     ' | sItem | ' -> ' | sLabel | ': ' | IF(nOK = 1, 'OK ', 'FAILED ') | sMsg);
			IF(nOK = 0);
				sItemFail = sItemFail | IF(sItemFail @= '', '', '; ') | sLabel | ': ' | IF(sMsg @= '', 'failed - see worker log', sMsg);
			ENDIF;
		ENDIF;
		nJ = SCAN(cSep, sJRest);
	END;

	IF(tMin = 0);
		tMin = tRunStart;
	ENDIF;
	IF(tMax < tMin);
		tMax = tMin;
	ENDIF;
	CellPutS(TIMST(tMin, cFmt), cCube, pDeployment, sItem, 'Deployment Start');
	CellPutS(TIMST(tMax, cFmt), cCube, pDeployment, sItem, 'Deployment End');
	CellPutS(NumberToString(ROUND((tMax - tMin) * 86400)), cCube, pDeployment, sItem, 'Deployment Duration');
	IF(sItemFail @= '');
		CellPutS('Success', cCube, pDeployment, sItem, 'Deployment Status');
	ELSE;
		nFailed = nFailed + 1;
		CellPutS(SUBST(sItemFail, 1, 1000), cCube, pDeployment, sItem, 'Deployment Status');
		ExecuteProcess(cLogProc, 'pFlag', 'MSG', 'pProc', cProc, 'pMSG', '     ' | sItem | ' FAILED: ' | sItemFail);
	ENDIF;
	nP = SCAN(cSep, sRest);
END;
#EndRegion

ELSE;
#Region --------------- Deploy Items (one at a time) ---------------
ExecuteProcess(cLogProc, 'pFlag', 'MSG', 'pProc', cProc, 'pMSG', 'Deploying ' | pDeployment | ' from ' | sThisDB);
nLoop = 1;
nMax = DIMSIZ(cItems);
WHILE(nLoop <= nMax);
	sItem = DIMNM(cItems, nLoop);
	IF(DTYPE(cItems, sItem) @<> 'C' & UPPER(CellGetS(cCube, pDeployment, sItem, 'Active')) @= 'YES');
		nItems = nItems + 1;
		sType = CellGetS(cCube, pDeployment, sItem, 'Type');
		sName = CellGetS(cCube, pDeployment, sItem, 'Name');
		tStart = NOW;
		CellPutS(TIMST(tStart, cFmt), cCube, pDeployment, sItem, 'Deployment Start');
		CellPutS('', cCube, pDeployment, sItem, 'Deployment End');
		CellPutS('', cCube, pDeployment, sItem, 'Deployment Duration');
		ExecuteProcess(cLogProc, 'pFlag', 'MSG', 'pProc', cProc, 'pMSG', sItem | ': ' | sType | ' ' | sName);

		#---- rights ----
		sItemFail = '';
		IF(nAdmin = 0);
			IF(sType @= 'Process' % sType @= 'Chore' % sType @= 'Rule');
				sItemFail = 'Insufficient rights to deploy ' | sType | 's';
			ELSEIF(sType @= 'Cube' & SCAN('SECURITY', UPPER(sName)) = 0);
				sItemFail = 'Insufficient rights to deploy Cubes';
			ENDIF;
		ENDIF;
		IF(sItemFail @= '' & sName @= '');
			sItemFail = 'Name is blank';
		ENDIF;

		#---- each target ----
		nTargets = 0;
		nT = 1;
		WHILE(nT <= 5 & sItemFail @= '' % nT <= 5 & nTargets > 0);
			sTEnv = CellGetS(cCube, pDeployment, sItem, 'Target ' | NumberToString(nT));
			IF(sTEnv @<> '' & UPPER(sTEnv) @<> 'NONE');
				nTargets = nTargets + 1;
				sTDB = '';
				sTTenant = '';
				IF(DimensionElementExists(cEnvDim, sTEnv) = 1);
					sTEnv = DimensionElementPrincipalName(cEnvDim, sTEnv);
					sTDB = CellGetS(cEnvs, sTEnv, 'Database Name');
					sTTenant = CellGetS(cEnvs, sTEnv, 'Tenant ID');
				ENDIF;
				nSameTenant = IF(sTTenant @= '' % UPPER(sTTenant) @= UPPER(sThisTenant), 1, 0);
				gDeployOK = 0;
				gDeployMsg = '';

				# workers get the environment; }Sys.API.Request resolves its database, URL, tenant and key
				IF(sTDB @= '');
					gDeployMsg = 'no Database Name for environment ' | sTEnv;
				ELSEIF(nSameTenant = 1 & UPPER(sTDB) @= UPPER(sThisDB) & sType @<> 'RunTI');
					gDeployMsg = 'target is the source database';
				ELSEIF(sType @= 'Dimension');
					ExecuteProcess('}Sys.API.Dim.Copy.ToDatabase', 'pDim', sName, 'pTargetDB', sTEnv,
						'pAttrValues', IF(UPPER(CellGetS(cCube, pDeployment, sItem, 'Include Attribute Values')) @= 'YES', 1, 0),
						'pAttrRules', IF(UPPER(CellGetS(cCube, pDeployment, sItem, 'Copy Attribute Rules')) @= 'YES', 1, 0),
						'pSubsets', IF(UPPER(CellGetS(cCube, pDeployment, sItem, 'Include Subsets')) @= 'YES', 1, 0),
						'pSecurity', IF(UPPER(CellGetS(cCube, pDeployment, sItem, 'Include Security Cube')) @= 'YES', 1, 0));
				ELSEIF(sType @= 'Subset');
					nPipe = SCAN('|', sName);
					IF(nPipe <= 1);
						gDeployMsg = 'Subset Name must be Dimension|Subset';
					ELSE;
						sSubDim = SUBST(sName, 1, nPipe - 1);
						sSubs = SUBST(sName, nPipe + 1, LONG(sName) - nPipe);
						sSubHier = '';
						nColon = SCAN(':', sSubDim);
						IF(nColon > 1);
							sSubHier = SUBST(sSubDim, nColon + 1, LONG(sSubDim) - nColon);
							sSubDim = SUBST(sSubDim, 1, nColon - 1);
						ENDIF;
						ExecuteProcess('}Sys.API.Subset.Copy', 'pDim', sSubDim, 'pHier', sSubHier, 'pSubsets', sSubs, 'pTargetDB', sTEnv);
					ENDIF;
				ELSEIF(sType @= 'Cube');
					ExecuteProcess('}Sys.API.Cube.Copy', 'pCube', sName, 'pTargetDB', sTEnv, 'pRules', 1, 'pData', 1, 'pClear', 1);
				ELSEIF(sType @= 'View');
					nPipe = SCAN('|', sName);
					IF(nPipe <= 1);
						gDeployMsg = 'View Name must be Cube|View';
					ELSE;
						ExecuteProcess('}Sys.API.View.Copy', 'pCube', SUBST(sName, 1, nPipe - 1), 'pView', SUBST(sName, nPipe + 1, LONG(sName) - nPipe), 'pTargetDB', sTEnv);
					ENDIF;
				ELSEIF(sType @= 'RunTI' % sType @= 'TI');
					sTO = CellGetS(cCube, pDeployment, sItem, 'Timeout');
					ExecuteProcess('}Sys.API.Process.Run', 'pTargetDB', sTEnv, 'pProcess', sName,
						'pParam1', CellGetS(cCube, pDeployment, sItem, 'Parameter 1'),
						'pParam2', CellGetS(cCube, pDeployment, sItem, 'Parameter 2'),
						'pParam3', CellGetS(cCube, pDeployment, sItem, 'Parameter 3'),
						'pParam4', CellGetS(cCube, pDeployment, sItem, 'Parameter 4'),
						'pParam5', CellGetS(cCube, pDeployment, sItem, 'Parameter 5'),
						'pParam6', CellGetS(cCube, pDeployment, sItem, 'Parameter 6'),
						'pParam7', CellGetS(cCube, pDeployment, sItem, 'Parameter 7'),
						'pParam8', CellGetS(cCube, pDeployment, sItem, 'Parameter 8'),
						'pParam9', CellGetS(cCube, pDeployment, sItem, 'Parameter 9'),
						'pParam10', CellGetS(cCube, pDeployment, sItem, 'Parameter 10'),
						'pTimeout', IF(sTO @= '', nDefTimeout, StringToNumber(sTO)), 'pPoll', 5);
				ELSEIF(sType @= 'Process' % sType @= 'Chore' % sType @= 'Rule');
					ExecuteProcess('}Sys.API.Object.Copy', 'pType', sType, 'pName', sName, 'pTargetDB', sTEnv);
				ELSE;
					gDeployMsg = 'unknown Type "' | sType | '"';
				ENDIF;

				ExecuteProcess(cLogProc, 'pFlag', 'MSG', 'pProc', cProc, 'pMSG',
					'     ' | sTEnv | ' (' | sTDB | IF(nSameTenant = 1, '', ' @ tenant ' | sTTenant) | '): ' | IF(gDeployOK = 1, 'OK ', 'FAILED ') | gDeployMsg);
				IF(gDeployOK = 0);
					sItemFail = sItemFail | IF(sItemFail @= '', '', '; ') | sTEnv | ': ' | IF(gDeployMsg @= '', 'failed - see worker log', gDeployMsg);
				ENDIF;
			ENDIF;
			nT = nT + 1;
		END;
		IF(sItemFail @= '' & nTargets = 0);
			sItemFail = 'No targets specified';
		ENDIF;

		#---- item status ----
		tEnd = NOW;
		CellPutS(TIMST(tEnd, cFmt), cCube, pDeployment, sItem, 'Deployment End');
		CellPutS(NumberToString(ROUND((tEnd - tStart) * 86400)), cCube, pDeployment, sItem, 'Deployment Duration');
		IF(sItemFail @= '');
			CellPutS('Success', cCube, pDeployment, sItem, 'Deployment Status');
		ELSE;
			nFailed = nFailed + 1;
			CellPutS(SUBST(sItemFail, 1, 1000), cCube, pDeployment, sItem, 'Deployment Status');
			ExecuteProcess(cLogProc, 'pFlag', 'MSG', 'pProc', cProc, 'pMSG', '     ' | sItem | ' FAILED: ' | sItemFail);
		ENDIF;
	ENDIF;
	nLoop = nLoop + 1;
END;
#EndRegion
ENDIF;

#endregion
#region Epilog
ExecuteProcess(cLogProc, 'pFlag', 'MSG', 'pProc', cProc, 'pMSG', 'Beginning Epilog');

#Region --------------- Overall Status ---------------
IF(nError = 0);
	tRunEnd = NOW;
	CellPutS(TIMST(tRunStart, cFmt), cCube, pDeployment, 'All Items', 'Deployment Start');
	CellPutS(TIMST(tRunEnd, cFmt), cCube, pDeployment, 'All Items', 'Deployment End');
	CellPutS(NumberToString(ROUND((tRunEnd - tRunStart) * 86400)), cCube, pDeployment, 'All Items', 'Deployment Duration');
	IF(nItems = 0);
		sMessage = 'NOTHING TO DEPLOY';
	ELSEIF(nFailed = 0);
		sMessage = 'Success';
	ELSE;
		sMessage = NumberToString(nFailed) | ' of ' | NumberToString(nItems) | ' items failed';
	ENDIF;
	CellPutS(sMessage, cCube, pDeployment, 'All Items', 'Deployment Status');
	ExecuteProcess(cLogProc, 'pFlag', 'MSG', 'pProc', cProc, 'pMSG', pDeployment | ': ' | sMessage);
ENDIF;
#EndRegion

sStatus = IF(nCritical = 1, 'ERROR', 'SUCCESS');
ExecuteProcess(cLogProc, 'pFlag', 'END', 'pProc', cProc, 'pMSG', sStatus);

#endregion