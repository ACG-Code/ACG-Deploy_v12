#region Prolog
#Region ############################################# HEADER #############################################
# Process: }Sys.Deploy.Setup.Rules
# Purpose: Step 2 of the deployment model setup - run AFTER }Sys.Deploy.Setup has finished
#          (the cubes must be committed) AND this database's connection values are set
#          (Base URL, Database Name, Tenant ID, API Key). Safe to re-run.
#          Sets the Deployment and }PickList_Deployment rules and creates the Deploy_Admin /
#          Deploy_User groups if missing.
#          Rule and group changes go to this same database over REST, so they are sent
#          ASYNC: a synchronous call would wait on this process's own open transaction until it
#          times out (HTTP 520). They are applied as soon as this process commits.
#          Groups are checked over REST, not with local }Groups functions: a local read would
#          lock }Groups and block the create.
# Date Created: 2026.11.24 (ACGI)
# Last Update: 2026.11.24
# Notes:
#     2026.11.24 (ACGI) - Initial Process Creation
#     2026.11.24 (ACGI) - Process Example standard + PLOG logging; rule errors fail the run
#     2026.11.24 (ACGI) - Process Log status (T08): ERROR only for critical errors
#     2026.11.24 (ACGI) - Missing connection values = critical error; group exists only on HTTP 200
#     2026.11.24 (ACGI) - Async rule/group calls; }PickList_Deployment Environments removed
#     2026.11.24 (ACGI) - Owner kept (informational): enterable on All Items and on each item
#     2026.11.24 (ACGI) - REST self-check: wrong connection values = critical error
#     2026.11.24 (ACGI) - Parameter 1-10 also enterable on Cube items (pSplitDim|<dim>, pSlices|<n>
#                         for parallel cube data slices); Timeout stays RunTI only
#EndRegion

#Region --------------- Constants ---------------
cLogProc = 'PLOG';
cProc = GetProcessName;
cUser = NumberToString(DIMIX('}Clients', TM1USER));
cTimestamp = TIMST(now, '\Y\m\d\h\i\s');
cRandomInt = NumberToString(INT(RAND() * 1005));
cView = '%cProc%.%cUser%.%cTimestamp%.%cRandomInt%';
cTemp = 1;
cNL = Char(10);
cItemDB = 'DB(''Deployment'', !Deployments, !Deployment - Items, ''Type'')';
cAdm = 'System - Admin Parameters';
cAPI = '}API Control';
NumericGlobalVariable('gHttpCode');
StringGlobalVariable('gHttpBody');
StringGlobalVariable('gHttpLocation');
StringGlobalVariable('gEnc');
#EndRegion

#Region --------------- Initialize Logging ---------------
ExecuteProcess(cLogProc, 'pFlag', 'INIT', 'pProc', cProc);
#EndRegion

#Region --------------- Error Handling ---------------
nError = 0;
nCritical = 0;
sMessage = '';
sFail = '';

IF(CubeExists('Deployment') = 0 % CubeExists('}PickList_Deployment') = 0 % CubeExists(cAdm) = 0 % CubeExists(cAPI) = 0);
	nError = 1;
	sMessage = 'deployment cubes missing - run }Sys.Deploy.Setup first';
ELSE;
	sMissing = '';
	IF(CellGetS(cAdm, 'Base URL', 'String') @= '');
		sMissing = sMissing | ' Base URL';
	ENDIF;
	IF(CellGetS(cAdm, 'Database Name', 'String') @= '');
		sMissing = sMissing | ' Database Name';
	ENDIF;
	IF(CellGetS(cAPI, 'Tenant ID', 'String') @= '');
		sMissing = sMissing | ' Tenant ID';
	ENDIF;
	IF(CellGetS(cAPI, 'API Key', 'String') @= '');
		sMissing = sMissing | ' API Key';
	ENDIF;
	IF(sMissing @<> '');
		nError = 1;
		sMessage = 'connection values missing:' | sMissing | ' - run }Sys.Deploy.Setup with pThisDB, pBaseURL, pTenantID and pApiKey, then run this process again';
	ENDIF;
ENDIF;

# the values are set - check they actually reach this database
IF(nError = 0);
	ExecuteProcess('}Sys.API.Request', 'pDB', '', 'pMethod', 'GET', 'pPath', '/Cubes(''Deployment'')?$select=Name');
	IF(gHttpCode <> 200);
		nError = 1;
		sMessage = 'cannot reach this database over REST (HTTP ' | NumberToString(gHttpCode) | ') - check Database Name ''' | CellGetS(cAdm, 'Database Name', 'String')
			| ''', Base URL, Tenant ID and API Key; correct them with }Sys.Deploy.Setup, then run this process again';
	ENDIF;
ENDIF;

IF(nError = 1);
	ExecuteProcess(cLogProc, 'pFlag', 'MSG', 'pProc', cProc, 'pMSG', sMessage);
	ExecuteProcess(cLogProc, 'pFlag', 'MSG', 'pProc', cProc, 'pMSG', 'Critical errors, exiting');
	nCritical = 1;
	ProcessBreak;
ENDIF;
#EndRegion

#Region --------------- Deployment rules ---------------
sR = 'SKIPCHECK;' | cNL | 'FEEDSTRINGS;' | cNL | cNL
	| '# All Items holds the deployment-level values (Owner is informational)' | cNL
	| '[''Deployment - Items'':''All Items'', ''mDeployments'':{''Name'', ''Owner'', ''Source'', ''Active'', ''Deployment Status'', ''Deployment Start'', ''Deployment End'', ''Deployment Duration''}] = S: STET;' | cNL
	| '[''Deployment - Items'':''All Items''] = S: '''';' | cNL | cNL
	| '# Source is set once per deployment (All Items)' | cNL
	| '[''mDeployments'':''Source''] = S: '''';' | cNL | cNL
	| '# Dimension options only apply to Dimension items' | cNL
	| '[''mDeployments'':{''Include Attribute Values'', ''Copy Attribute Rules'', ''Include Subsets'', ''Include Security Cube''}] = S:' | cNL
	| '  IF(' | cItemDB | ' @<> ''Dimension'', '''', STET);' | cNL | cNL
	| '# Parameters apply to RunTI items (process parameters) and Cube items (pSplitDim|<dim>, pSlices|<n>)' | cNL
	| '[''mDeployments'':{''Parameter 1'', ''Parameter 2'', ''Parameter 3'', ''Parameter 4'', ''Parameter 5'', ''Parameter 6'', ''Parameter 7'', ''Parameter 8'', ''Parameter 9'', ''Parameter 10''}] = S:' | cNL
	| '  IF(' | cItemDB | ' @<> ''RunTI'' & ' | cItemDB | ' @<> ''Cube'', '''', STET);' | cNL | cNL
	| '# Timeout only applies to RunTI items' | cNL
	| '[''mDeployments'':''Timeout''] = S:' | cNL
	| '  IF(' | cItemDB | ' @<> ''RunTI'', '''', STET);' | cNL | cNL
	| 'FEEDERS;' | cNL;
ExecuteProcess('}Sys.API.Encode', 'pText', sR, 'pMode', 'json');
ExecuteProcess('}Sys.API.Request', 'pDB', '', 'pMethod', 'PATCH', 'pPath', '/Cubes(''Deployment'')', 'pBody', '{"Rules":"' | gEnc | '"}', 'pAsync', 1);
ExecuteProcess(cLogProc, 'pFlag', 'MSG', 'pProc', cProc, 'pMSG', 'Deployment rules queued HTTP ' | NumberToString(gHttpCode));
IF(gHttpCode <> 202);
	sFail = sFail | IF(sFail @= '', '', '; ') | 'Deployment rules HTTP ' | NumberToString(gHttpCode);
ENDIF;
#EndRegion

#Region --------------- }PickList_Deployment rules ---------------
sR = '[''mDeployments'':{''Active'', ''Include Attribute Values'', ''Copy Attribute Rules'', ''Include Subsets'', ''Include Security Cube''}, ''}PickList'':''Value''] = S: ''Static:Yes:No'';' | cNL
	| '[''mDeployments'':''Type'', ''}PickList'':''Value''] = S: ''Static:Dimension:Subset:Cube:View:RunTI:Process:Chore:Rule'';' | cNL
	| '[''mDeployments'':{''Source'', ''Target 1'', ''Target 2'', ''Target 3'', ''Target 4'', ''Target 5''}, ''}PickList'':''Value''] = S: ''Subset:Deployment-Environments:System - Leaves'';' | cNL
	| '[''mDeployments'':''Name'', ''}PickList'':''Value''] = S:' | cNL
	| '  IF(' | cItemDB | ' @= ''Dimension'', ''Dimension:}Dimensions'',' | cNL
	| '  IF(' | cItemDB | ' @= ''Cube'' % ' | cItemDB | ' @= ''Rule'', ''Dimension:}Cubes'',' | cNL
	| '  IF(' | cItemDB | ' @= ''Process'' % ' | cItemDB | ' @= ''RunTI'', ''Dimension:}Processes'',' | cNL
	| '  IF(' | cItemDB | ' @= ''Chore'', ''Dimension:}Chores'', ''''))));' | cNL;
ExecuteProcess('}Sys.API.Encode', 'pText', sR, 'pMode', 'json');
ExecuteProcess('}Sys.API.Request', 'pDB', '', 'pMethod', 'PATCH', 'pPath', '/Cubes(''%7DPickList_Deployment'')', 'pBody', '{"Rules":"' | gEnc | '"}', 'pAsync', 1);
ExecuteProcess(cLogProc, 'pFlag', 'MSG', 'pProc', cProc, 'pMSG', '}PickList_Deployment rules queued HTTP ' | NumberToString(gHttpCode));
IF(gHttpCode <> 202);
	sFail = sFail | IF(sFail @= '', '', '; ') | '}PickList_Deployment rules HTTP ' | NumberToString(gHttpCode);
ENDIF;
#EndRegion

#Region --------------- Security groups (checked over REST - see header) ---------------
sList = 'Deploy_Admin|Deploy_User|';
nPos = SCAN('|', sList);
WHILE(nPos > 0);
	sG = SUBST(sList, 1, nPos - 1);
	sList = SUBST(sList, nPos + 1, LONG(sList) - nPos);
	ExecuteProcess('}Sys.API.Request', 'pDB', '', 'pMethod', 'GET', 'pPath', '/Groups(''' | sG | ''')?$select=Name');
	IF(gHttpCode = 200);
		ExecuteProcess(cLogProc, 'pFlag', 'MSG', 'pProc', cProc, 'pMSG', 'Group ' | sG | ' exists');
	ELSEIF(gHttpCode = 404);
		ExecuteProcess('}Sys.API.Request', 'pDB', '', 'pMethod', 'POST', 'pPath', '/Groups', 'pBody', '{"Name":"' | sG | '"}', 'pAsync', 1);
		ExecuteProcess(cLogProc, 'pFlag', 'MSG', 'pProc', cProc, 'pMSG', 'Group ' | sG | ' create queued HTTP ' | NumberToString(gHttpCode));
		IF(gHttpCode <> 202);
			sFail = sFail | IF(sFail @= '', '', '; ') | 'group ' | sG | ': HTTP ' | NumberToString(gHttpCode);
		ENDIF;
	ELSE;
		sFail = sFail | IF(sFail @= '', '', '; ') | 'group ' | sG | ' check HTTP ' | NumberToString(gHttpCode);
		ExecuteProcess(cLogProc, 'pFlag', 'MSG', 'pProc', cProc, 'pMSG', 'Group ' | sG | ' check failed HTTP ' | NumberToString(gHttpCode));
	ENDIF;
	nPos = SCAN('|', sList);
END;
#EndRegion

IF(sFail @<> '');
	nError = 1;
	sMessage = sFail;
ENDIF;

#endregion
#region Epilog
ExecuteProcess(cLogProc, 'pFlag', 'MSG', 'pProc', cProc, 'pMSG', 'Beginning Epilog');

ExecuteProcess(cLogProc, 'pFlag', 'MSG', 'pProc', cProc, 'pMSG',
	IF(nError = 1, sMessage, 'rules and groups queued - applied when this process commits'));

sStatus = IF(nCritical = 1, 'ERROR', 'SUCCESS');
ExecuteProcess(cLogProc, 'pFlag', 'END', 'pProc', cProc, 'pMSG', sStatus);

#endregion